{
  "buildCommand": "php artisan:build || true",
  "outputDirectory": "public",
  "framework": null,
  "installCommand": "composer install --no-dev --optimize-autoloader && npm install && npm run build",
  "routes": [
    { "src": "/storage/(.*)", "dest": "/storage/$1" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
